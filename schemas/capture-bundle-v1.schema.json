{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kurosaki.capture_bundle.v1",
  "title": "KUROSAKI capture bundle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "capture_id",
    "emulator_version",
    "rom_sha256",
    "mapper",
    "submapper",
    "start_frame",
    "end_frame",
    "start_cpu_cycle",
    "end_cpu_cycle",
    "trace_event_count",
    "artifacts"
  ],
  "properties": {
    "schema": { "const": "kurosaki.capture_bundle.v1" },
    "capture_id": { "type": "string", "minLength": 1 },
    "emulator_version": { "type": "string", "minLength": 1 },
    "rom_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "mapper": { "type": "integer", "minimum": 0, "maximum": 4095 },
    "submapper": { "type": "integer", "minimum": 0, "maximum": 15 },
    "start_frame": { "type": "integer", "minimum": 0 },
    "end_frame": { "type": "integer", "minimum": 1 },
    "start_cpu_cycle": { "type": "integer", "minimum": 0 },
    "end_cpu_cycle": { "type": "integer", "minimum": 1 },
    "trace_event_count": { "type": "integer", "minimum": 1 },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_snapshot", "end_snapshot", "trace"],
      "properties": {
        "start_snapshot": { "$ref": "#/$defs/artifact" },
        "end_snapshot": { "$ref": "#/$defs/artifact" },
        "trace": { "$ref": "#/$defs/artifact" }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "byte_length", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "byte_length": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
