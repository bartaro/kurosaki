{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kurosaki.capture_bundle_checkpoints.v1",
  "title": "KUROSAKI capture bundle checkpoint index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "capture_id", "rom_sha256", "checkpoints"],
  "properties": {
    "schema": { "const": "kurosaki.capture_bundle_checkpoints.v1" },
    "capture_id": { "type": "string", "minLength": 1 },
    "rom_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "checkpoints": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/checkpoint" }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "byte_length", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "byte_length": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "label", "frame", "cpu_cycle", "snapshot", "image"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "label": { "type": "string", "pattern": "^checkpoint-[0-9]{4,}$" },
        "frame": { "type": "integer", "minimum": 0 },
        "cpu_cycle": { "type": "integer", "minimum": 0 },
        "snapshot": { "$ref": "#/$defs/artifact" },
        "image": { "$ref": "#/$defs/artifact" }
      }
    }
  }
}
